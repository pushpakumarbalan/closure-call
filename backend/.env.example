# --- NWS (public, no key) ---
# NWS asks for a descriptive User-Agent with a contact address.
NWS_USER_AGENT=ClosureCall/0.1 (hackmidwest2026; you@example.com)

# --- Akamai Cloud hosted inference (OpenAI-compatible). Fill in from the kickoff handout. ---
# BYOI works identically: point LLM_BASE_URL at any OpenAI-compatible endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_ID=

# --- Optional supplementary signal: AirNow (free key at https://docs.airnowapi.org/account/request/) ---
# If empty, air quality falls back to NWS "Air Quality Alert" products.
AIRNOW_API_KEY=

# --- Storage ---
DB_PATH=./data/closurecall.sqlite3
